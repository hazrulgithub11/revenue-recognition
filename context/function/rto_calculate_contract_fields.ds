organizationID = organization.get("organization_id");
domainUrl = organization.get("api_root_endpoint");
customModuleApiName = "cm_rent_to_own_contract";

recordID = cm_rent_to_own_contract.get("module_record_id");

if(recordID == null || recordID == "")
{
	info "rto_calculate_contract_fields: missing module_record_id";
	return;
}

getResponse = invokeurl
[
	url :domainUrl + "/" + customModuleApiName + "/" + recordID + "?organization_id=" + organizationID
	type :GET
	connection :"zbooks"
];

if(getResponse.get("code") != 0)
{
	info "rto_calculate_contract_fields: GET failed — " + getResponse.get("message");
	return;
}

record = getResponse.get("module_record");
if(record == null)
{
	info "rto_calculate_contract_fields: empty module_record";
	return;
}

fieldMap = Map();
recordHash = getResponse.get("module_record_hash");
if(recordHash != null)
{
	fieldMap.putAll(recordHash);
}
moduleFields = record.get("module_fields");
if(moduleFields != null)
{
	for each fld in moduleFields
	{
		apiName = fld.get("api_name");
		if(apiName != null)
		{
			fieldMap.put(apiName, fld.get("value"));
		}
	}
}

// Prefer trigger map (workflow), then parsed GET fields, then flat module_record
nRaw = cm_rent_to_own_contract.get("cf_rto_period");
pvRaw = cm_rent_to_own_contract.get("cf_rto_principal_wip");
pmtRaw = cm_rent_to_own_contract.get("cf_rto_monthly_payment_amount_wip");

if(nRaw == null || nRaw == "")
{
	nRaw = fieldMap.get("cf_rto_period");
}
if(nRaw == null || nRaw == "")
{
	nRaw = record.get("cf_rto_period");
}
if(pvRaw == null || pvRaw == "")
{
	pvRaw = fieldMap.get("cf_rto_principal_wip");
}
if(pvRaw == null || pvRaw == "")
{
	pvRaw = record.get("cf_rto_principal_wip");
}
if(pmtRaw == null || pmtRaw == "")
{
	pmtRaw = fieldMap.get("cf_rto_monthly_payment_amount_wip");
}
if(pmtRaw == null || pmtRaw == "")
{
	pmtRaw = record.get("cf_rto_monthly_payment_amount_wip");
}

if(nRaw == null || nRaw == "" || pvRaw == null || pvRaw == "" || pmtRaw == null || pmtRaw == "")
{
	info "rto_calculate_contract_fields: skip — period / principal / monthly payment missing — n=" + nRaw + " PV=" + pvRaw + " PMT=" + pmtRaw;
	return;
}

n = nRaw.toDecimal();
PV = pvRaw.toDecimal();
PMT = pmtRaw.toDecimal();

if(n <= 0 || PV <= 0 || PMT <= 0)
{
	info "rto_calculate_contract_fields: skip — period / principal / monthly payment must be > 0";
	return;
}

// Newton-Raphson: solve PV = PMT * (1 - (1+r)^(-n)) / r
r = 0.01;
tolerance = 0.0000000001;
converged = false;

iterList = "".leftPad(99).toList("");
info "iterList size=" + iterList.size();

for each index i in iterList
{
	onePlusRate = 1 + r;
	powTerm = onePlusRate.power(0 - n);
	numerator = 1 - powTerm;
	f = PMT * (numerator / r) - PV;

	if(abs(f) < tolerance)
	{
		converged = true;
		break;
	}

	du = n * onePlusRate.power(0 - n - 1);
	dA = (du * r - numerator) / (r * r);
	fPrime = PMT * dA;

	if(abs(fPrime) < 0.000000000000001)
	{
		break;
	}

	r = r - (f / fPrime);
	if(r <= 0)
	{
		r = 0.0001;
	}
	if(r > 1)
	{
		r = 1;
	}
}

if(converged == false)
{
	info "rto_calculate_contract_fields: RATE did not fully converge after 100 iterations; writing last r=" + r;
}

interest_tot = round((PMT * n) - PV, 2);
paid_off = 0;
balance = round((PV + interest_tot) - paid_off, 2);

updateMap = Map();
updateMap.put("cf_rto_interest_wip", r);
updateMap.put("cf_interest_total_wip", interest_tot);
updateMap.put("cf_rto_paid_off_amount_wip", paid_off);
updateMap.put("cf_rto_current_balance", balance);

body = Map();
body.put("JSONString", updateMap);

putResponse = invokeurl
[
	url :domainUrl + "/" + customModuleApiName + "/" + recordID + "?organization_id=" + organizationID
	type :PUT
	parameters :body
	connection :"zbooks"
];

if(putResponse.get("code") != 0)
{
	info "rto_calculate_contract_fields: PUT failed — " + putResponse.get("message");
	return;
}

info "rto_calculate_contract_fields: updated " + recordID + " r=" + r + " interest_tot=" + interest_tot + " balance=" + balance;

// ============================================================
// PHASE 2 — Generate Amortisation Periods (RTO Transactions)
// Spec: context/feature-specs/03-rto-transactions/overview.md
// Issue: github.com/hazrulgithub11/revenue-recognition/issues/1
//
// Flow (one atomic path, runs after RATE is committed):
//   1. Read start date + customer from contract
//   2. List existing periods for this contract
//   3. Lock check — if any period is NOT Pending, skip regeneration
//   4. Delete all existing Pending periods
//   5. Create n new Amortisation Periods (Excel amort loop 1:1)
// ============================================================

txModuleApiName = "cm_rto_transactions";

// --- 1. Read start date ---
// fieldMap and record are always Maps — .get(string) is safe on them.
// Deluge has no typeof; avoid calling .get(string) on non-Map values.
startDateRaw = fieldMap.get("cf_rto_start_date");
if(startDateRaw == null || startDateRaw == "")
{
	startDateRaw = record.get("cf_rto_start_date");
}
if(startDateRaw == null || startDateRaw == "")
{
	startDateRaw = cm_rent_to_own_contract.get("cf_rto_start_date");
}

if(startDateRaw == null || startDateRaw == "")
{
	info "rto_calculate_contract_fields: skip period gen — cf_rto_start_date missing";
	return;
}

// --- 1b. Read customer ID ---
// module_fields.value for a lookup field is a plain entity ID string.
// If the API ever returns a nested Map, its .toString() in Deluge looks like
// {id=12345, name=...} — we detect this with contains("=") and parse it out.
customerRaw = fieldMap.get("cf_customer");
if(customerRaw == null || customerRaw == "")
{
	customerRaw = record.get("cf_customer");
}
if(customerRaw == null || customerRaw == "")
{
	customerRaw = cm_rent_to_own_contract.get("cf_customer");
}

customerId = "";
if(customerRaw != null && customerRaw != "")
{
	customerStr = customerRaw.toString();
	// If it looks like a Map string representation, extract the ID value
	if(customerStr.contains("id="))
	{
		idPart = customerStr.getSuffix("id=");
		trimmedId = idPart.getPrefix(",");
		if(trimmedId == null || trimmedId == "")
		{
			trimmedId = idPart.getPrefix("}");
		}
		if(trimmedId != null && trimmedId != "")
		{
			customerId = trimmedId;
		}
	}
	if(customerId == "")
	{
		customerId = customerStr;
	}
}

// --- 2. List existing Amortisation Periods for this contract ---
// Use per_page=200; contracts have at most ~120 periods (10-year term).
listUrl = domainUrl + "/" + txModuleApiName + "?organization_id=" + organizationID + "&per_page=200";
listResp = invokeurl
[
	url :listUrl
	type :GET
	connection :"zbooks"
];

if(listResp.get("code") != 0)
{
	info "rto_calculate_contract_fields: LIST periods failed — " + listResp.get("message") + "; skipping period generation to avoid duplicates";
	return;
}

existingPeriods = list();
anyNotPending = false;

allPeriods = listResp.get("module_records");
if(allPeriods != null)
{
	for each pRec in allPeriods
	{
		// pRec is always a Map from the LIST response — .get(string) is safe.
		// For field *values* (lookup / dropdown) we use .toString() + string parsing;
		// never call .get("key") on the value itself (may be a plain ID, not a Map).

		contractRecId = "";
		contractLookupRaw = pRec.get("cf_rto_contract_no");
		if(contractLookupRaw != null && contractLookupRaw != "")
		{
			contractStr = contractLookupRaw.toString();
			// Detect Map toString like "{entity_id=XYZ,...}" or "{id=XYZ,...}"
			if(contractStr.contains("entity_id="))
			{
				idPart = contractStr.getSuffix("entity_id=");
				trimmedId = idPart.getPrefix(",");
				if(trimmedId == null || trimmedId == "")
				{
					trimmedId = idPart.getPrefix("}");
				}
				if(trimmedId != null && trimmedId != "")
				{
					contractRecId = trimmedId;
				}
			}
			else if(contractStr.contains("id="))
			{
				idPart = contractStr.getSuffix("id=");
				trimmedId = idPart.getPrefix(",");
				if(trimmedId == null || trimmedId == "")
				{
					trimmedId = idPart.getPrefix("}");
				}
				if(trimmedId != null && trimmedId != "")
				{
					contractRecId = trimmedId;
				}
			}
			else
			{
				// Plain ID string — use directly
				contractRecId = contractStr;
			}
		}

		if(contractRecId == recordID.toString())
		{
			existingPeriods.add(pRec);

			// Status: plain string ("Pending") or Map toString ("{name=Pending,...}")
			statusName = "";
			statusRaw = pRec.get("cf_status");
			if(statusRaw != null && statusRaw != "")
			{
				statusStr = statusRaw.toString();
				if(statusStr.contains("name="))
				{
					namePart = statusStr.getSuffix("name=");
					trimmedName = namePart.getPrefix(",");
					if(trimmedName == null || trimmedName == "")
					{
						trimmedName = namePart.getPrefix("}");
					}
					if(trimmedName != null && trimmedName != "")
					{
						statusName = trimmedName;
					}
				}
				else
				{
					statusName = statusStr;
				}
			}

			if(statusName != "Pending")
			{
				anyNotPending = true;
			}
		}
	}
}

// --- 3. Lock check ---
// If any period is NOT Pending the schedule is frozen.
// Decision: regenerate only when every existing period is still Pending.
// Ref: learning-records/0003-regenerate-if-all-pending.md
if(anyNotPending)
{
	info "rto_calculate_contract_fields: schedule locked — " + existingPeriods.size() + " period(s) exist for contract " + recordID + ", at least one is not Pending; regeneration blocked";
	return;
}

// --- 4. Delete all existing Pending periods ---
for each pRec in existingPeriods
{
	pRecId = pRec.get("module_record_id");
	if(pRecId == null || pRecId == "")
	{
		pRecId = pRec.get("id");
	}
	if(pRecId != null && pRecId != "")
	{
		delResp = invokeurl
		[
			url :domainUrl + "/" + txModuleApiName + "/" + pRecId + "?organization_id=" + organizationID
			type :DELETE
			connection :"zbooks"
		];
		if(delResp.get("code") != 0)
		{
			info "rto_calculate_contract_fields: DELETE period " + pRecId + " failed — " + delResp.get("message");
		}
	}
}

// --- 5. Create n new Amortisation Periods (Excel amort loop 1:1) ---
// Ref: learning-records/0005-excel-amort-no-plug.md
// Ref: learning-records/0006-pmt-and-customer-copy.md
// Ref: learning-records/0007-excel-1to1-and-lock-edits.md
//
// Loop variables:
//   opening   — start of period receivable; period-1 seeded from cf_rto_principal_wip (RTO Principal WIP)
//   interest  = round(opening × r, 2)
//   cash      = PMT if opening > 1, else 0  (Excel cash guard)
//   principal = round(cash − interest, 2)
//   closing   = round(opening − principal, 2)
//   next opening = max(0, closing)  — Excel ≤0 guard
//
// Date: period-1 date = cf_rto_start_date; each subsequent = prior + 1 calendar month (EDATE).

// Normalise start date to "yyyy-MM-dd" (strip timestamp if present)
// Deluge has no split() — use getPrefix / toList
startDateStr = startDateRaw.toString();
datePrefix = startDateStr.getPrefix("T");
if(datePrefix != null)
{
	startDateStr = datePrefix;
}

sdParts = startDateStr.toList("-");
curYear = sdParts.get(0).toDecimal();
curMonth = sdParts.get(1).toDecimal();
curDay = sdParts.get(2).toDecimal();

opening = PV;

// Dummy list of 200 items — break at index n (n validated > 0; contracts ≤ 120 months)
periodDummy = "".leftPad(200).toList("");

for each index idx in periodDummy
{
	if(idx >= n)
	{
		break;
	}

	// --- Excel amort formulas ---
	interest = round(opening * r, 2);

	cash = PMT;
	if(opening <= 1)
	{
		cash = 0.0;
	}

	principal = round(cash - interest, 2);
	closing = round(opening - principal, 2);

	// --- Build period date string "yyyy-MM-dd" ---
	// Using string concatenation ("" + number) to avoid Decimal.toString() trailing ".0"
	if(curMonth < 10)
	{
		mStr = "0" + curMonth;
	}
	else
	{
		mStr = "" + curMonth;
	}
	if(curDay < 10)
	{
		dStr = "0" + curDay;
	}
	else
	{
		dStr = "" + curDay;
	}
	periodDateStr = "" + curYear + "-" + mStr + "-" + dStr;

	// --- POST new Amortisation Period record ---
	// cf_rto_contract_no: pass the contract record ID for the field-based lookup
	// cf_status: "Pending" (Books form default is "Default" — must be set explicitly)
	// cf_customer: copied from contract (learning-records/0006-pmt-and-customer-copy.md)
	periodData = Map();
	if(customerId != null && customerId != "")
	{
		periodData.put("cf_customer", customerId);
	}
	periodData.put("cf_rto_contract_no", recordID);
	periodData.put("cf_date", periodDateStr);
	periodData.put("cf_status", "Pending");
	periodData.put("cf_principal_opening_balance", opening);
	periodData.put("cf_payment_amount", cash);
	periodData.put("cf_finance_income", interest);
	periodData.put("cf_principal_reduction", principal);
	periodData.put("cf_principal_closing_balance", closing);

	periodBody = Map();
	periodBody.put("JSONString", periodData);

	createResp = invokeurl
	[
		url :domainUrl + "/" + txModuleApiName + "?organization_id=" + organizationID
		type :POST
		parameters :periodBody
		connection :"zbooks"
	];

	if(createResp.get("code") != 0)
	{
		info "rto_calculate_contract_fields: CREATE period " + (idx + 1) + " (" + periodDateStr + ") failed — " + createResp.get("message");
	}

	// --- Advance to next period ---
	// Next opening: closing clamped to 0 if ≤ 0 (Excel ≤0 guard; no last-line force-zero plug)
	opening = closing;
	if(opening < 0)
	{
		opening = 0.0;
	}

	// Next date: +1 calendar month (EDATE)
	curMonth = curMonth + 1;
	if(curMonth > 12)
	{
		curMonth = 1;
		curYear = curYear + 1;
	}

	// Clamp day for shorter months (e.g. Jan-31 + 1 month → Feb-28/29)
	daysInMonth = 31;
	if(curMonth == 4 || curMonth == 6 || curMonth == 9 || curMonth == 11)
	{
		daysInMonth = 30;
	}
	else if(curMonth == 2)
	{
		// Gregorian leap-year rule
		if(curYear % 4 == 0 && (curYear % 100 != 0 || curYear % 400 == 0))
		{
			daysInMonth = 29;
		}
		else
		{
			daysInMonth = 28;
		}
	}
	if(curDay > daysInMonth)
	{
		curDay = daysInMonth;
	}
}

info "rto_calculate_contract_fields: generated " + n + " Amortisation Period(s) for contract " + recordID;
